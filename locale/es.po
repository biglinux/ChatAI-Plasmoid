#: contents/ui/settings/WebFeaturesSettings.qml:38
msgid "Lets you type immediately after the page loads. Disable if the page steals focus from the toolbar."
msgstr "Permite escribir en cuanto la página carga. Desactívalo si la página roba el foco de la barra de herramientas."

#: contents/ui/settings/WebFeaturesSettings.qml:39
msgid "Allow unknown link types after a click"
msgstr "Permitir tipos de enlace desconocidos tras un clic"

#: contents/ui/settings/WebFeaturesSettings.qml:39
msgid "Lets a link you click open another application (for example mailto: or a custom scheme). Links opened by scripts are still blocked."
msgstr "Permite que un enlace que pulses abra otra aplicación (por ejemplo mailto: o un esquema personalizado). Los enlaces abiertos por scripts siguen bloqueados."

#: contents/ui/settings/WebFeaturesSettings.qml:43
msgid "These options change how the embedded web engine behaves for every assistant. Changes apply immediately."
msgstr "Estas opciones cambian el comportamiento del motor web integrado para todos los asistentes. Los cambios se aplican de inmediato."

