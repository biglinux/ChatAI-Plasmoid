#: contents/ui/ProviderModel.qml:42
msgid "Google sign-in works with the default browser identity. If Google says the browser may not be secure, make sure \"Identify as Chromium\" is off in Advanced."
msgstr "Google innskráning virkar með sjálfgefna vafra auðkenni. Ef Google segir að vafrinn sé ekki öruggur, vertu viss um að \"Auðkenna sem Chromium\" sé slökkt á í Fyrirfram."

#: contents/ui/ProviderModel.qml:48
msgid "OpenAI's assistant with voice, files and web search."
msgstr "Aðstoðarmaður OpenAI með raddstýringu, skrám og vefleit."

#: contents/ui/ProviderModel.qml:55
msgid "Anthropic's assistant for writing, analysis and code."
msgstr "Aðstoðarmaður Anthropic fyrir skrif, greiningu og kóða."

#: contents/ui/ProviderModel.qml:58
msgid "Claude only allows account creation and Google sign-in in well-known browsers. Sign in with an e-mail code or reuse credentials created in a regular browser."
msgstr "Claude leyfir aðeins að búa til reikninga og skrá sig inn með Google í vel þekktum vöfrum. Skráðu þig inn með tölvupóstkóða eða endurnotaðu auðkenni sem búið var til í venjulegri vöfru."

#: contents/ui/ProviderModel.qml:63
msgid "Google's multimodal assistant."
msgstr "Margmiðlunar aðstoðarmaður Google."

#: contents/ui/ProviderModel.qml:70
msgid "DeepSeek's chat with reasoning mode."
msgstr "Samskipti við DeepSeek með röksemdarfærslu."

#: contents/ui/ProviderModel.qml:77
msgid "Private, anonymous access to several models. No account needed."
msgstr "Persónuleg, nafnlaus aðgangur að nokkrum líkanum. Engin reikningur nauðsynlegur."

#: contents/ui/ProviderModel.qml:84
msgid "Answer engine with cited web sources."
msgstr "Svar vélar með tilvitnunum í vefsíður."

#: contents/ui/ProviderModel.qml:91
msgid "Microsoft's assistant (formerly Bing Copilot)."
msgstr "Aðstoðarmaður Microsofts (fyrrum Bing Copilot)."

#: contents/ui/ProviderModel.qml:98
msgid "Copilot Chat on github.com with repository context. Requires a GitHub account."
msgstr "Copilot spjall á github.com með samhengi skráasafns. Krafist er GitHub reiknings."

#: contents/ui/ProviderModel.qml:105
msgid "Mistral's assistant and agent (formerly Le Chat)."
msgstr "Aðstoðarmaður og umboðsmaður Mistral (fyrrum Le Chat)."

#: contents/ui/ProviderModel.qml:112
msgid "xAI's assistant. Works without an account with limits."
msgstr "xAI aðstoðarmaður. Vinnur án reiknings með takmörkunum."

#: contents/ui/ProviderModel.qml:119
msgid "Alibaba's Qwen Studio: chat, images, documents and web search."
msgstr "Qwen Studio hjá Alibaba: spjall, myndir, skjöl og vefleit."

#: contents/ui/ProviderModel.qml:126
msgid "Moonshot AI's assistant with long-context and research modes."
msgstr "Aðstoðarmaður Moonshot AI með langa samhengi og rannsóknarham."

#: contents/ui/ProviderModel.qml:133
msgid "General AI agent with a chat mode. Requires an account."
msgstr "Almennur AI aðili með spjallham. Krafist er að skrá sig."

#: contents/ui/ProviderModel.qml:140
msgid "Hugging Face's chat with open models (Omni router)."
msgstr "Samskipti við opna líkön (Omni router) frá Hugging Face."

#: contents/ui/ProviderModel.qml:147
msgid "Meta's assistant. Availability depends on your region."
msgstr "Aðstoðarmaður Meta. Framboð fer eftir svæðinu þínu."

#: contents/ui/ProviderModel.qml:154
msgid "Fast multi-model chat client."
msgstr "Hraðvirkur fjölgerðar spjallviðskiptavinur."

#: contents/ui/ProviderModel.qml:161
msgid "You.com chat. The product now targets enterprise users; a login is required."
msgstr "You.com spjall. Varan beinist nú að miða að fyrirtækjanotendum; innskráning er nauðsynleg."

#: contents/ui/ProviderModel.qml:168
msgid "Coding-oriented assistant."
msgstr "Kóðunarstýrður aðstoðarmaður."

#: contents/ui/ProviderModel.qml:175
msgid "LobeHub cloud chat (bring your own keys or subscription)."
msgstr "LobeHub skýja spjall (taktu með þínar eigin lykla eða áskrift)."

#: contents/ui/ProviderModel.qml:182
msgid "Big-AGI web client (bring your own keys)."
msgstr "Big-AGI vefklient (taktu með þínum eigin lykilorðum)."

